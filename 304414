import sqlite3
import hashlib
import secrets
from datetime import datetime, timezone

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import uvicorn


APP_NAME = "Distra"
DB_NAME = "distra.db"

app = FastAPI(title="Distra API")


# =========================
# DATABASE
# =========================

def get_db():
    db = sqlite3.connect(DB_NAME)
    db.row_factory = sqlite3.Row
    return db


def init_db():
    db = get_db()
    cur = db.cursor()

    cur.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            email TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL,
            token TEXT,
            created_at TEXT NOT NULL
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS communities (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT UNIQUE NOT NULL,
            description TEXT DEFAULT '',
            owner_id INTEGER NOT NULL,
            created_at TEXT NOT NULL
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS members (
            community_id INTEGER NOT NULL,
            user_id INTEGER NOT NULL,
            role TEXT DEFAULT 'member',
            UNIQUE(community_id, user_id)
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS channels (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            community_id INTEGER NOT NULL,
            name TEXT NOT NULL,
            created_at TEXT NOT NULL
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            channel_id INTEGER NOT NULL,
            user_id INTEGER NOT NULL,
            content TEXT NOT NULL,
            created_at TEXT NOT NULL
        )
    """)

    db.commit()
    db.close()


init_db()


# =========================
# HELPERS
# =========================

def hash_password(password):
    return hashlib.sha256(
        password.encode("utf-8")
    ).hexdigest()


def current_time():
    return datetime.now(timezone.utc).isoformat()


# =========================
# MODELS
# =========================

class RegisterData(BaseModel):
    username: str
    email: str
    password: str


class LoginData(BaseModel):
    identity: str
    password: str


class CommunityData(BaseModel):
    name: str
    description: str = ""
    owner_id: int


class MessageData(BaseModel):
    channel_id: int
    user_id: int
    content: str


# =========================
# HOME
# =========================

@app.get("/")
def home():
    return {
        "app": APP_NAME,
        "status": "online"
    }


@app.get("/health")
def health():
    return {
        "status": "ok",
        "database": "connected"
    }


# =========================
# REGISTER
# =========================

@app.post("/register")
def register(data: RegisterData):

    username = data.username.strip()
    email = data.email.strip().lower()
    password = data.password

    if len(username) < 3:
        raise HTTPException(
            status_code=400,
            detail="Username must be at least 3 characters"
        )

    if len(password) < 6:
        raise HTTPException(
            status_code=400,
            detail="Password must be at least 6 characters"
        )

    db = get_db()

    try:

        cur = db.cursor()

        cur.execute("""
            INSERT INTO users
            (username, email, password_hash, created_at)
            VALUES (?, ?, ?, ?)
        """, (
            username,
            email,
            hash_password(password),
            current_time()
        ))

        db.commit()

        user_id = cur.lastrowid

        return {
            "success": True,
            "user_id": user_id,
            "username": username,
            "message": "Account created"
        }

    except sqlite3.IntegrityError:

        raise HTTPException(
            status_code=409,
            detail="Username or email already exists"
        )

    finally:
        db.close()


# =========================
# LOGIN
# =========================

@app.post("/login")
def login(data: LoginData):

    identity = data.identity.strip().lower()

    db = get_db()

    user = db.execute("""
        SELECT *
        FROM users
        WHERE lower(username) = ?
           OR lower(email) = ?
    """, (
        identity,
        identity
    )).fetchone()

    if not user:
        db.close()

        raise HTTPException(
            status_code=401,
            detail="Invalid username/email or password"
        )

    if user["password_hash"] != hash_password(data.password):
        db.close()

        raise HTTPException(
            status_code=401,
            detail="Invalid username/email or password"
        )

    token = secrets.token_hex(32)

    db.execute("""
        UPDATE users
        SET token = ?
        WHERE id = ?
    """, (
        token,
        user["id"]
    ))

    db.commit()
    db.close()

    return {
        "success": True,
        "user_id": user["id"],
        "username": user["username"],
        "email": user["email"],
        "token": token
    }


# =========================
# USER
# =========================

@app.get("/users/{user_id}")
def get_user(user_id: int):

    db = get_db()

    user = db.execute("""
        SELECT id, username, email, created_at
        FROM users
        WHERE id = ?
    """, (user_id,)).fetchone()

    db.close()

    if not user:
        raise HTTPException(
            status_code=404,
            detail="User not found"
        )

    return dict(user)


# =========================
# COMMUNITIES
# =========================

@app.post("/communities")
def create_community(data: CommunityData):

    name = data.name.strip()

    if len(name) < 2:
        raise HTTPException(
            status_code=400,
            detail="Community name is too short"
        )

    db = get_db()

    try:

        cur = db.cursor()

        cur.execute("""
            INSERT INTO communities
            (name, description, owner_id, created_at)
            VALUES (?, ?, ?, ?)
        """, (
            name,
            data.description,
            data.owner_id,
            current_time()
        ))

        community_id = cur.lastrowid

        cur.execute("""
            INSERT INTO members
            (community_id, user_id, role)
            VALUES (?, ?, 'owner')
        """, (
            community_id,
            data.owner_id
        ))

        cur.execute("""
            INSERT INTO channels
            (community_id, name, created_at)
            VALUES (?, 'general', ?)
        """, (
            community_id,
            current_time()
        ))

        db.commit()

        return {
            "success": True,
            "community_id": community_id,
            "name": name
        }

    except sqlite3.IntegrityError:

        raise HTTPException(
            status_code=409,
            detail="Community already exists"
        )

    finally:
        db.close()


@app.get("/communities")
def get_communities():

    db = get_db()

    rows = db.execute("""
        SELECT
            c.id,
            c.name,
            c.description,
            c.owner_id,
            COUNT(m.user_id) AS members
        FROM communities c
        LEFT JOIN members m
            ON c.id = m.community_id
        GROUP BY c.id
        ORDER BY c.id DESC
    """).fetchall()

    db.close()

    return {
        "communities": [
            dict(row) for row in rows
        ]
    }


@app.post("/communities/{community_id}/join/{user_id}")
def join_community(
    community_id: int,
    user_id: int
):

    db = get_db()

    try:

        db.execute("""
            INSERT INTO members
            (community_id, user_id, role)
            VALUES (?, ?, 'member')
        """, (
            community_id,
            user_id
        ))

        db.commit()

        return {
            "success": True,
            "message": "Joined community"
        }

    except sqlite3.IntegrityError:

        raise HTTPException(
            status_code=409,
            detail="Already a member"
        )

    finally:
        db.close()


# =========================
# CHANNELS
# =========================

@app.get("/communities/{community_id}/channels")
def get_channels(community_id: int):

    db = get_db()

    rows = db.execute("""
        SELECT id, name, created_at
        FROM channels
        WHERE community_id = ?
        ORDER BY id
    """, (community_id,)).fetchall()

    db.close()

    return {
        "channels": [
            dict(row) for row in rows
        ]
    }


# =========================
# SEND MESSAGE
# =========================

@app.post("/messages")
def send_message(data: MessageData):

    content = data.content.strip()

    if not content:
        raise HTTPException(
            status_code=400,
            detail="Message cannot be empty"
        )

    db = get_db()

    cur = db.cursor()

    cur.execute("""
        INSERT INTO messages
        (channel_id, user_id, content, created_at)
        VALUES (?, ?, ?, ?)
    """, (
        data.channel_id,
        data.user_id,
        content,
        current_time()
    ))

    db.commit()

    message_id = cur.lastrowid

    db.close()

    return {
        "success": True,
        "message_id": message_id,
        "content": content
    }


# =========================
# GET MESSAGES
# =========================

@app.get("/channels/{channel_id}/messages")
def get_messages(channel_id: int):

    db = get_db()

    rows = db.execute("""
        SELECT
            messages.id,
            messages.content,
            messages.created_at,
            users.id AS user_id,
            users.username
        FROM messages
        JOIN users
            ON users.id = messages.user_id
        WHERE messages.channel_id = ?
        ORDER BY messages.id ASC
    """, (channel_id,)).fetchall()

    db.close()

    return {
        "messages": [
            dict(row) for row in rows
        ]
    }


