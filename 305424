import flet as ft

from components.ui import screen


def _document(app, title, paragraphs):
    return screen(
        title,
        ft.Column(
            controls=[ft.Text(title, size=26, weight=ft.FontWeight.BOLD), *[ft.Text(item) for item in paragraphs]],
            scroll=ft.ScrollMode.AUTO,
            expand=True,
            spacing=16,
        ),
        back=lambda e: app.navigate("settings"),
    )


def privacy(app):
    return _document(app, "سياسة الخصوصية", [
        "تشرح هذه الصفحة كيف سيتعامل Distra مع البيانات عند تشغيل خدماته المتصلة.",
        "يجمع Distra الحد الأدنى من البيانات اللازمة لتشغيل الحسابات والمجتمعات والمحادثات، ولا يعرض بيانات أو نشاطاً غير حقيقي.",
        "تُستخدم بيانات الحساب لإدارة الوصول والأمان. ستتوفر إعدادات تفصيلية للتحكم في البيانات عند ربط الواجهة بالخدمة الخلفية.",
        "يمكن التواصل مع الدعم للاستفسارات المتعلقة بالخصوصية.",
    ])


def terms(app):
    return _document(app, "شروط الخدمة", [
        "باستخدام Distra، توافق على استخدام المنصة باحترام وأمان.",
        "لا يجوز إساءة استخدام المجتمعات أو إرسال محتوى ضار أو انتهاك خصوصية الآخرين.",
        "قد تتغير الخدمات والميزات عند ربط Distra بالبنية الخلفية. ستُنشر التحديثات المهمة داخل التطبيق.",
        "لمزيد من المساعدة، راجع مركز دعم Distra.",
    ])


def guidelines(app):
    return _document(app, "إرشادات المجتمع", [
        "احترم الأعضاء والمساحات التي تشارك فيها.",
        "لا تشارك معلومات شخصية للآخرين دون إذن، ولا تستخدم المحادثات للإساءة أو المضايقة.",
        "ساعد في الحفاظ على نقاشات واضحة وآمنة، وأبلغ عن المخالفات عند توفر أدوات الإبلاغ المتصلة.",
        "يجوز لمديري المجتمعات وضع قواعد إضافية لمساحاتهم.",
    ])
