import flet as ft

from components.ui import BORDER, brand, empty_state, primary_button, quiet_button, screen


def home(app):
    return empty_state(
        ft.Icons.HOME,
        "لا توجد نشاطات بعد",
        "ستظهر هنا تحديثات مجتمعاتك ومحادثاتك الحقيقية.",
        [
            primary_button("استكشف المجتمعات", lambda e: app.navigate("communities"), ft.Icons.SEARCH),
            quiet_button("ابدأ محادثة", lambda e: app.navigate("messages"), ft.Icons.CHAT),
        ],
    )


def communities(app):
    return screen(
        "المجتمعات",
        empty_state(
            ft.Icons.GROUPS,
            "لا توجد مجتمعات بعد",
            "عند اتصال الخدمة، ستظهر المجتمعات التي انضممت إليها هنا.",
            [primary_button("اكتشف المجتمعات", lambda e: app.navigate("discover"), ft.Icons.SEARCH)],
        ),
        trailing=quiet_button("اكتشف", lambda e: app.navigate("discover"), ft.Icons.SEARCH),
    )


def discover(app):
    search = ft.TextField(label="ابحث عن مجتمع", prefix_icon=ft.Icons.SEARCH, border_color=BORDER)

    def search_unavailable(e):
        app.set_notice("البحث عن المجتمعات سيتاح عند اتصال الخدمة.")

    body = ft.Column(
        controls=[
            search,
            primary_button("بحث", search_unavailable, ft.Icons.SEARCH),
            empty_state(
                ft.Icons.GROUPS,
                "لا توجد مجتمعات متاحة",
                "لا يمكن عرض أو إنشاء نتائج حتى تتصل خدمة المجتمعات بالواجهة الخلفية.",
            ),
        ],
        expand=True,
        scroll=ft.ScrollMode.AUTO,
    )
    return screen("اكتشف المجتمعات", body, back=lambda e: app.navigate("communities"))


