def channels(app):
    composer = ft.TextField(label="اكتب رسالة", expand=True, border_color=BORDER)

    def unavailable(e):
        app.set_notice("إرسال الرسائل والمرفقات يتطلب اتصال خدمة المحادثات.")

    body = ft.Column(
        controls=[
            empty_state(
                ft.Icons.CHAT,
                "لا توجد قناة محددة",
                "اختر مجتمعاً وقناة نصية حقيقية لبدء المحادثة.",
                [quiet_button("الذهاب للمجتمعات", lambda e: app.navigate("communities"), ft.Icons.GROUPS)],
            ),
            ft.Row(
                controls=[
                    quiet_button("مرفق", unavailable, ft.Icons.ATTACH_FILE),
                    quiet_button("رمز", unavailable, ft.Icons.EMOJI_EMOTIONS),
                    composer,
                    primary_button("إرسال", unavailable, ft.Icons.SEND),
                ],
                vertical_alignment=ft.CrossAxisAlignment.CENTER,
            ),
        ],
        expand=True,
    )
    return screen("القناة", body, back=lambda e: app.navigate("communities"))


